{
  "name": "@devcodex/extraction-runtime",
  "version": "1.0.0",
  "description": "URL-based structured OCR provider runtime with a Mistral adapter and compatible legacy parsers.",
  "type": "module",
  "license": "MIT",
  "author": "DevCodex Labs",
  "homepage": "https://github.com/devcodex-labs/extraction-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devcodex-labs/extraction-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/devcodex-labs/extraction-runtime/issues"
  },
  "keywords": [
    "extraction",
    "parser",
    "runtime",
    "text-extraction",
    "file-parser",
    "ocr",
    "structured-extraction",
    "mistral",
    "document-ai"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run build && node --test",
    "pack:dry": "npm pack --dry-run",
    "test:live:mistral": "npm run build && node scripts/mistral-live.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/node": "^20.19.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
